# Portainer Migrator Configuration

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Database (SQLite by default, embedded)
DATABASE_PATH=./data/migrator.db

# License Configuration
LICENSE_KEY=
LICENSE_SERVER_URL=https://license.yourcompany.com

# Dokploy Connection (optional - for direct integration)
DOKPLOY_URL=http://localhost:3000
DOKPLOY_API_KEY=

# Security
JWT_SECRET=your-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_TELEMETRY=false
ENABLE_AUTO_UPDATE=true
